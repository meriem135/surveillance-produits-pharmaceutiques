# Copier en backend/.env puis adapter. Toutes les variables sont optionnelles.

# Secret de signature des JWT (sans lui : clé éphémère, sessions perdues au redémarrage)
JWT_SECRET_KEY=change-me

# Compte administrateur créé au premier démarrage s'il n'existe aucun admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@peaksoft.local
ADMIN_PASSWORD=

# PostgreSQL (la seule base prise en charge)
# (avec Docker, docker-compose.yml remplace cette valeur par le conteneur db)
DATABASE_URL=postgresql+asyncpg://iot_user:iot_secure_password@localhost:5432/iot_security

# Origines autorisées par CORS (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
