{
    "name":  "frontend",
    "private":  true,
    "version":  "0.0.0",
    "type":  "module",
    "scripts":  {
                    "dev":  "vite",
                    "build":  "tsc -b \u0026\u0026 vite build",
                    "lint":  "eslint .",
                    "preview":  "vite preview",
                    "deploy":  "vite build \u0026\u0026 powershell -Command \"Remove-Item -Recurse -Force ../backend/static -ErrorAction SilentlyContinue; New-Item -ItemType Directory -Force -Path ../backend/static/assets | Out-Null; Copy-Item -Recurse -Path dist/* -Destination ../backend/static/ -Force; Move-Item -Path ../backend/static/*.js,../backend/static/*.css -Destination ../backend/static/assets/ -Force -ErrorAction SilentlyContinue\""
                },
